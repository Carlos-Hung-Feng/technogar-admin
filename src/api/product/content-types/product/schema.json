{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "required": true
    },
    "RetailPrice": {
      "type": "decimal",
      "required": true
    },
    "MinimumQuantity": {
      "type": "integer",
      "required": true,
      "default": 1
    },
    "Weight": {
      "type": "decimal",
      "required": false
    },
    "Dimensions": {
      "type": "string",
      "default": "0.00x0.00"
    },
    "Photos": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "Supplier": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::supplier.supplier",
      "inversedBy": "Products"
    },
    "Active": {
      "type": "boolean",
      "default": true
    },
    "Category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "Products"
    },
    "Warehouse_Inventories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::warehouse-inventory.warehouse-inventory",
      "mappedBy": "Product"
    },
    "BarCode": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "PurchaseOrder_Products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::purchase-order-product.purchase-order-product",
      "mappedBy": "Product"
    },
    "WholesalePrice": {
      "type": "decimal",
      "required": true
    },
    "Invoice_Products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invoice-product.invoice-product",
      "mappedBy": "Product"
    },
    "Warranty": {
      "type": "integer",
      "default": 0
    },
    "Description": {
      "type": "richtext",
      "required": true
    },
    "SKU": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "Online": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "WholesalePrice_2": {
      "type": "decimal",
      "required": true
    },
    "WholesalePrice_3": {
      "type": "decimal",
      "required": true
    },
    "WholesalePercentage": {
      "type": "integer",
      "required": true,
      "default": 10
    },
    "WholesalePercentage_2": {
      "type": "integer",
      "required": true,
      "default": 20
    },
    "WholesalePercentage_3": {
      "type": "integer",
      "required": true,
      "default": 30
    },
    "Credit_Note_Products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::credit-note-product.credit-note-product",
      "mappedBy": "Product"
    }
  }
}
