{
  "kind": "collectionType",
  "collectionName": "credit_notes",
  "info": {
    "singularName": "credit-note",
    "pluralName": "credit-notes",
    "displayName": "Credit_Note",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "CreditNoteNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "TotalAmount": {
      "type": "decimal",
      "required": true,
      "unique": false
    },
    "GeneratedUser": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "credit_notes"
    },
    "NCF": {
      "type": "string",
      "unique": true
    },
    "RemainingAmount": {
      "type": "decimal",
      "required": true
    },
    "Credit_Note_Products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::credit-note-product.credit-note-product",
      "mappedBy": "Credit_Note"
    },
    "Credit_Note_Applications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::credit-note-application.credit-note-application",
      "mappedBy": "Credit_Note"
    },
    "Created_From_Invoice": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::invoice.invoice",
      "inversedBy": "Credit_Notes"
    }
  }
}
