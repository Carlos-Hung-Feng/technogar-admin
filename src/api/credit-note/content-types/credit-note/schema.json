{
  "kind": "collectionType",
  "collectionName": "credit_notes",
  "info": {
    "singularName": "credit-note",
    "pluralName": "credit-notes",
    "displayName": "Credit_Note",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "CreditNoteNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "Total": {
      "type": "decimal",
      "required": true,
      "unique": false
    },
    "GeneratedUser": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "credit_notes"
    },
    "AppliedToInvoices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invoice.invoice",
      "mappedBy": "CreditNoteApplied"
    },
    "Invoice_Products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invoice-product.invoice-product",
      "mappedBy": "CreditNote"
    },
    "NCF": {
      "type": "string",
      "unique": true
    }
  }
}
